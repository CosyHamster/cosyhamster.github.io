{
  "name": "@axonkit/libsamplerate-js",
  "version": "0.1.0",
  "description": "Audio sample-rate conversion for the browser via a WebAssembly build of libsamplerate (separate .wasm + tiny glue).",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./wasm-runtime": "./dist/wasm-runtime.mjs",
    "./wasm/*": "./dist/wasm/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build:wasm": "cd wasm && bash build.sh",
    "build:ts": "rollup -c rollup.config.mjs",
    "build": "npm run build:wasm && npm run build:ts",
    "dev": "rollup -c rollup.config.mjs -w",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "verify:wasm": "test -f wasm/out/libsamplerate.wasm || (echo 'ERROR: wasm/out/libsamplerate.wasm missing. Run `npm run build:wasm` (requires Emscripten).' && exit 1)",
    "prepublishOnly": "npm run verify:wasm && npm run clean && npm run build:ts && test -f dist/wasm/libsamplerate.wasm"
  },
  "keywords": [
    "libsamplerate",
    "sample rate",
    "resample",
    "resampler",
    "wasm",
    "webassembly",
    "web audio",
    "audio",
    "dsp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axonkit/libsamplerate-js.git"
  },
  "bugs": {
    "url": "https://github.com/axonkit/libsamplerate-js/issues"
  },
  "homepage": "https://github.com/axonkit/libsamplerate-js#readme",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "prettier": "^3.4.2",
    "rollup": "^4.28.0",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0"
  }
}
